# Copy to .env (never committed). The default pipeline runs fully local and needs no API keys.
# Every variable maps to qareena.config.Settings (prefix QAREENA_, nested with "__").

QAREENA_MODE=live                          # live | eval  (cloud_reference is refused in live mode)
QAREENA_OLLAMA_URL=http://127.0.0.1:11434  # native API (/api/chat): JSON schema + logprobs
QAREENA_VLM_MODEL=qwen3.5:4b               # to be confirmed by the day-1 spike
QAREENA_OCR_ENGINE=rapidocr_ppocrv5_ar     # rapidocr_ppocrv5_ar | tesseract
QAREENA_GEMINI_API_KEY=                    # eval mode only, synthetic data only
QAREENA_DATA_KEY=                          # Fernet key for encrypting stored case files

# Feature flags (engineering switches; also used for ablations). Policy lives in config/policy.yaml.
# QAREENA_FEATURES__EVIDENCE_LOOP=true
# QAREENA_FEATURES__OCR_GROUNDING=true
# QAREENA_FEATURES__TWO_SOURCE_RULE=true
# QAREENA_FEATURES__PDF_INTAKE=true
# QAREENA_FEATURES__CLOUD_REFERENCE=false
