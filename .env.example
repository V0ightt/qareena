# Copy to .env (never committed). The default pipeline runs fully local and needs no API keys.
QAREENA_READER=local                      # local | gemini  (gemini = offline benchmark on synthetic data only)
QAREENA_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
QAREENA_VLM_MODEL=qwen3.5:4b              # candidate; final choice after the week-1 bake-off
QAREENA_OCR_ENGINE=ppocrv5_arabic         # ppocrv5_arabic | surya | tesseract
GEMINI_API_KEY=
QAREENA_DATA_KEY=                         # Fernet key for encrypting stored case files
QAREENA_RETENTION_HOURS=24                # demo setting; production retention follows ZainCash/CBI policy
